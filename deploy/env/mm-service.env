# Supernoba Market Maker Service Environment Variables
# EC2: server (stock-bastion)

# === MM 기본 설정 ===
MM_DEFAULT_TICK_INTERVAL=1000
MM_STATUS_PUBLISH_INTERVAL=2000

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/mm-service/mm-service.log

# === Kinesis 설정 ===
# [2026-02-12 감사] MM 코드는 KINESIS_STREAM을 읽음 (common.env의 KINESIS_ORDERS_STREAM과 다른 이름)
# common.env의 KINESIS_ORDERS_STREAM은 매칭엔진용, 여기서 명시적으로 MM용 설정
KINESIS_STREAM=supernoba-orders

# === Redis/Valkey Override (EC2 로컬) ===
# common.env의 ElastiCache 주소를 오버라이드
# systemd EnvironmentFile은 후순위 파일이 우선 적용됨
DEPTH_CACHE_HOST=127.0.0.1
BACKUP_CACHE_HOST=127.0.0.1
OPERATING_CACHE_HOST=127.0.0.1
CANDLE_CACHE_HOST=127.0.0.1
VALKEY_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
# [2026-02-12 감사] EC2 localhost는 TLS 미지원 — common.env의 VALKEY_TLS=true 오버라이드
# MM 코드에 localhost guard가 있지만 명시적 오버라이드가 안전
VALKEY_TLS=false
