# Supernoba Matching Engine Environment Variables
# EC2: server (stock-bastion)

# === gRPC ===
GRPC_PORT=50051

# === DynamoDB 로드 설정 ===
LOAD_ORDERS_FROM_DYNAMODB=true

# === Kinesis 체크포인팅 설정 (안정적 재시작) ===
KINESIS_CHECKPOINT_ENABLED=true
KINESIS_CHECKPOINT_INTERVAL_RECORDS=100
KINESIS_CHECKPOINT_INTERVAL_SECONDS=5

# === Graceful Shutdown 설정 ===
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# === Shard 관리 설정 (Iterator 만료 방지) ===
KINESIS_ITERATOR_REFRESH_SECONDS=240

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/engine/engine.log

# Redis/Valkey localhost 오버라이드는 localhost-override.env로 통합됨
