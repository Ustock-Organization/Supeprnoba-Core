# Supernoba Matching Engine Environment Variables
# EC2: server (stock-bastion)

# === gRPC ===
GRPC_PORT=50051

# === DynamoDB 로드 설정 ===
LOAD_ORDERS_FROM_DYNAMODB=true

# === Kinesis 체크포인팅 설정 (안정적 재시작) ===
KINESIS_CHECKPOINT_ENABLED=true
KINESIS_CHECKPOINT_INTERVAL_RECORDS=100
KINESIS_CHECKPOINT_INTERVAL_SECONDS=5

# === 복구 모드 (AWS: 이벤트 소싱 리플레이) ===
# replay: 스냅샷과 정합한 앵커(engine:snapshot:anchor)에서 Kinesis 재생 → 다운타임 유입분 유실 0.
#         스냅샷~크래시 사이 10초 유실창과 시간우선순위 소실을 원리적으로 제거.
# clear:  레거시 — 체크포인트 삭제 후 LATEST(유입분 유실). CLEAR_CHECKPOINTS_ON_START로 세부제어.
RECOVERY_MODE=replay

# === Graceful Shutdown 설정 ===
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30

# === Shard 관리 설정 (Iterator 만료 방지) ===
KINESIS_ITERATOR_REFRESH_SECONDS=240

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/engine/engine.log

# Redis/Valkey localhost 오버라이드는 localhost-override.env로 통합됨

# === gRPC 관리 채널 인증 (P1 보안) ===
# 파괴적 RPC(CancelAllOrders/RemoveOrderBook 등) 무인증 노출 방지.
# delisting Lambda도 동일 값을 ENGINE_GRPC_TOKEN으로 설정해야 함. 미설정 시 경고 후 허용(하위호환).
# 평문 전송이므로 VPC 내부 전제 — 완전 보안은 mTLS 필요(후속).
ENGINE_GRPC_TOKEN=

# === 가격 밴드 (C4 — 얇은 종목 조작/fat-finger 방지) ===
# LIMIT 주문이 직전 체결가 ±PRICE_BAND_PCT 범위를 벗어나면 엔진이 거부.
# 0=비활성. 얇은 종목 특성 고려해 넉넉히(예: 0.5=±50%). 첫 거래 전(기준가 없음)은 통과.
# ⚠ VI 서킷브레이커 도입 시 halt 검사를 밴드보다 먼저 수행할 것.
PRICE_BAND_PCT=0.5

# === VI 서킷브레이커 (C5 — 급변 시 종목 일시정지, KRX 동적 VI 단순형) ===
# 직전 체결가 대비 |변동률| >= VI_DYNAMIC_PCT 이면 해당 종목 VI_HALT_SECONDS초 정지.
# 정지 중 신규 주문 거부(halt 검사가 가격밴드보다 우선). 자동 해제.
# 상태는 Valkey symbol:{S}:state(HALTED/CONTINUOUS)로 전파 → MM은 halt 시 호가 철회해야 함.
# 0=비활성. 예: 0.10=±10% 급변 시 halt.
VI_DYNAMIC_PCT=0.10
VI_HALT_SECONDS=120
