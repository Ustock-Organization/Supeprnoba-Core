# Supernoba Localhost Override
# EC2에서 모든 서비스가 공유하는 로컬 Redis/Valkey 오버라이드
#
# common.env의 ElastiCache 원격 주소를 127.0.0.1로 오버라이드
# systemd EnvironmentFile 로딩 순서: common.env → localhost-override.env → {service}.env
#
# EC2 localhost는 TLS 미지원이므로 VALKEY_TLS=false 필수

DEPTH_CACHE_HOST=127.0.0.1
BACKUP_CACHE_HOST=127.0.0.1
OPERATING_CACHE_HOST=127.0.0.1
CANDLE_CACHE_HOST=127.0.0.1
VALKEY_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
VALKEY_TLS=false
