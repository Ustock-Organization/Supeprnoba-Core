# Supernoba Candle Aggregator Environment Variables
# EC2: aggregator (stock-aggregator)

# === RDS PostgreSQL ===
# 비밀번호는 ~/.secrets/rds.env에 별도 저장
RDS_HOST=supernoba-rdb1.cluster-cyxfcbnpfoci.ap-northeast-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DBNAME=postgres
RDS_USER=njg7194
# RDS_PASSWORD는 별도 파일에서 source

# === 폴링 설정 ===
POLL_INTERVAL_MS=10

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/aggregator/aggregator.log
