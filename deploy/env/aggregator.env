# Supernoba Candle Aggregator Environment Variables
# EC2: aggregator (stock-aggregator)

# === AWS Secrets Manager ===
# RDS 비밀번호는 AWS Secrets Manager에서 가져옴
DB_CREDENTIALS_SECRET_NAME=supernoba/db-credentials

# === 폴링 설정 ===
POLL_INTERVAL_MS=10

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/aggregator/aggregator.log

# === Redis/Valkey Override (EC2 로컬) ===
# common.env의 ElastiCache 주소를 오버라이드
# systemd EnvironmentFile은 후순위 파일이 우선 적용됨
DEPTH_CACHE_HOST=127.0.0.1
BACKUP_CACHE_HOST=127.0.0.1
OPERATING_CACHE_HOST=127.0.0.1
CANDLE_CACHE_HOST=127.0.0.1
VALKEY_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
# [2026-02-12 감사] EC2 localhost는 TLS 미지원 — common.env의 VALKEY_TLS=true 오버라이드
VALKEY_TLS=false
