# Supernoba Streamer Environment Variables
# EC2: streamer (stock-streamer)

# === 폴링 설정 ===
# [2026-02-12 감사] 코드(index.mjs)에서 미참조 — 하드코딩된 50ms/500ms 사용
# 향후 코드에서 env 참조 시 활성화
# DEPTH_POLL_INTERVAL_MS=50
# CANDLE_POLL_INTERVAL_MS=500

# === 로그 파일 ===
LOG_FILE=/var/log/supernoba/streamer/streamer.log

# === Redis/Valkey Override (EC2 로컬) ===
# common.env의 ElastiCache 주소를 오버라이드
# systemd EnvironmentFile은 후순위 파일이 우선 적용됨
DEPTH_CACHE_HOST=127.0.0.1
BACKUP_CACHE_HOST=127.0.0.1
OPERATING_CACHE_HOST=127.0.0.1
CANDLE_CACHE_HOST=127.0.0.1
VALKEY_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
# [2026-02-12 감사] CRITICAL: EC2 localhost는 TLS 미지원
# common.env의 VALKEY_TLS=true가 Streamer 5개 ioredis 연결에 TLS 적용 → 연결 실패
# 반드시 false로 오버라이드 필요
VALKEY_TLS=false
