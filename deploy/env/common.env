# Supernoba Common Environment Variables
# 모든 서비스가 공유하는 환경변수

# === AWS 설정 ===
AWS_REGION=ap-northeast-2

# === Valkey (Backup Cache) ===
# 설정 및 상태 관리용
BACKUP_CACHE_HOST=master.supernobaorderbookbackupcache.5vrxzz.apn2.cache.amazonaws.com

# === Valkey (Depth Cache) ===
# 실시간 호가 데이터용
DEPTH_CACHE_HOST=supernoba-depth-cache.5vrxzz.ng.0001.apn2.cache.amazonaws.com

# === Valkey/Redis (C++ compatibility aliases) ===
# REDIS_HOST는 스냅샷/체크포인트 저장용으로 Backup Cache 사용
VALKEY_HOST=supernoba-depth-cache.5vrxzz.ng.0001.apn2.cache.amazonaws.com
VALKEY_PORT=6379
VALKEY_TLS=true
REDIS_HOST=master.supernobaorderbookbackupcache.5vrxzz.apn2.cache.amazonaws.com
REDIS_PORT=6379

# === Kinesis Streams ===
KINESIS_ORDERS_STREAM=supernoba-orders
KINESIS_TRADES_STREAM=supernoba-trades
KINESIS_DEPTH_STREAM=supernoba-depth
KINESIS_FILLS_STREAM=supernoba-fills
KINESIS_STATUS_STREAM=supernoba-order-status

# === DynamoDB ===
DYNAMODB_ORDERS_TABLE=supernoba-orders
DYNAMODB_HOLDINGS_TABLE=supernoba-holdings
DYNAMODB_WALLETS_TABLE=supernoba-users
DYNAMODB_STOCKS_TABLE=supernoba-symbols

# === WebSocket ===
# Streamer/Engine이 https://${WEBSOCKET_ENDPOINT} 형태로 사용하므로 프로토콜 접두사 금지
# [2026-02-12] API GW ID: Core_Old=l2ptm85wub, Supernoba-back=qbg5kmqm0c — 확인 필요
WEBSOCKET_ENDPOINT=l2ptm85wub.execute-api.ap-northeast-2.amazonaws.com/production
ADMIN_WEBSOCKET_ENDPOINT=sa1arlclz4.execute-api.ap-northeast-2.amazonaws.com/production

# === 4-Cache Port Configuration ===
DEPTH_CACHE_PORT=6379
CANDLE_CACHE_PORT=6380
BACKUP_CACHE_PORT=6381
OPERATING_CACHE_PORT=6382
OPERATING_CACHE_HOST=127.0.0.1
CANDLE_CACHE_HOST=127.0.0.1

# === 로깅 ===
LOG_LEVEL=INFO
