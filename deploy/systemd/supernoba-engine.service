[Unit]
Description=Supernoba Matching Engine
Documentation=https://github.com/user/Supernoba-Core_Old
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Supernoba-Core_Old/wrapper/build

# 환경변수
EnvironmentFile=/home/ec2-user/Supernoba-Core_Old/deploy/env/common.env
EnvironmentFile=/home/ec2-user/Supernoba-Core_Old/deploy/env/engine.env

# 실행
ExecStart=/home/ec2-user/Supernoba-Core_Old/wrapper/build/matching_engine

# 재시작 정책
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# 메모리 제한 (누수 방지)
MemoryMax=2G
MemoryHigh=1536M

# 프로세스 제한
LimitNOFILE=65535
LimitNPROC=4096

# 로깅
StandardOutput=append:/var/log/supernoba/engine/engine.log
StandardError=append:/var/log/supernoba/engine/engine.log

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
