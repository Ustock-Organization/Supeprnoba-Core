[Unit]
Description=Supernoba Market Maker Service
Documentation=https://github.com/user/Supeprnoba-Core
After=network-online.target supernoba-engine.service
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Supeprnoba-Core/mm-service

# 환경변수
EnvironmentFile=/home/ec2-user/Supeprnoba-Core/deploy/env/common.env
EnvironmentFile=/home/ec2-user/Supeprnoba-Core/deploy/env/mm-service.env

# Node.js 메모리 제한
Environment="NODE_OPTIONS=--max-old-space-size=512"

# 실행
ExecStart=/usr/bin/node index.mjs

# 재시작 정책
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

# 메모리 제한 (누수 방지)
MemoryMax=1024M
MemoryHigh=768M

# 프로세스 제한
LimitNOFILE=65535

# 로깅
StandardOutput=append:/var/log/supernoba/mm-service/mm-service.log
StandardError=append:/var/log/supernoba/mm-service/mm-service.log

# Graceful shutdown
TimeoutStopSec=15
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
