[Unit]
Description=Supernoba Candle Aggregator
Documentation=https://github.com/user/Supeprnoba-Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Supeprnoba-Core/aggregator/build

# 환경변수
EnvironmentFile=/home/ec2-user/Supeprnoba-Core/deploy/env/common.env
EnvironmentFile=/home/ec2-user/Supeprnoba-Core/deploy/env/aggregator.env
# 비밀번호 별도 파일 (필수)
EnvironmentFile=/home/ec2-user/.secrets/rds.env

# 실행
ExecStart=/home/ec2-user/Supeprnoba-Core/aggregator/build/candle_aggregator

# 재시작 정책
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# 메모리 제한 (누수 방지)
MemoryMax=1024M
MemoryHigh=768M

# 프로세스 제한
LimitNOFILE=65535

# 로깅
StandardOutput=append:/var/log/supernoba/aggregator/aggregator.log
StandardError=append:/var/log/supernoba/aggregator/aggregator.log

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
