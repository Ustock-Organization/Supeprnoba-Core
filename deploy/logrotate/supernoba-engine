# Supernoba Matching Engine 로그 로테이션 설정
# 위치: /etc/logrotate.d/supernoba-engine
# 대상 서버: server (stock-bastion)

/var/log/supernoba/engine/*.log {
    daily
    maxsize 200M
    rotate 5
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d-%H%M
}
