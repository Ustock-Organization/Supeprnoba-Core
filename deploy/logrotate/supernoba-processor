# Supernoba Stock Processor 로그 로테이션 설정
# 위치: /etc/logrotate.d/supernoba-processor
# 대상 서버: processor (stock-processor)

/var/log/supernoba/processor/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0644 ec2-user ec2-user
    dateext
    dateformat -%Y%m%d
    sharedscripts
    postrotate
        # systemd가 관리하므로 재시작 불필요
        true
    endscript
}
