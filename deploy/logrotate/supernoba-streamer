# Supernoba Streamer 로그 로테이션 설정
# 위치: /etc/logrotate.d/supernoba-streamer
# 대상 서버: streamer (stock-streamer)

/var/log/supernoba/streamer/*.log {
    daily
    maxsize 100M
    rotate 5
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d-%H%M
}
