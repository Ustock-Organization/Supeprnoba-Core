# Supernoba Candle Aggregator 로그 로테이션 설정
# 위치: /etc/logrotate.d/supernoba-aggregator
# 대상 서버: aggregator (stock-aggregator)

/var/log/supernoba/aggregator/*.log {
    daily
    maxsize 50M
    rotate 5
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d-%H%M
}
