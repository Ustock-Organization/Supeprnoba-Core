# Supernoba Candle Aggregator 로그 로테이션 설정
# 위치: /etc/logrotate.d/supernoba-aggregator
# 대상 서버: stock-aggregator (EC2)

/var/log/supernoba/aggregator/*.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    create 0644 ubuntu ubuntu
    dateext
    dateformat -%Y%m%d
    sharedscripts
    postrotate
        /usr/bin/pkill -HUP -f 'candle_aggregator' 2>/dev/null || true
    endscript
}
